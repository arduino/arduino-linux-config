# create leds directories
SUBSYSTEM=="leds", ACTION=="add" RUN+="/usr/bin/mkdir -p /dev/leds"

# builtin leds
SUBSYSTEM=="leds", KERNEL=="unoq:*", ACTION=="add", RUN+="/usr/bin/mkdir -p /dev/leds/builtin"
SUBSYSTEM=="leds", KERNEL=="unoq:*", ACTION=="remove", RUN+="/usr/bin/mkdir -p /dev/leds/builtin"

# --- User LEDs (Mapped to led1) ---
SUBSYSTEM=="leds", KERNEL=="unoq:user-red1",   ACTION=="add", RUN+="/bin/ln -sf /sys$devpath /dev/leds/builtin/led1_r"
SUBSYSTEM=="leds", KERNEL=="unoq:user-green1", ACTION=="add", RUN+="/bin/ln -sf /sys$devpath /dev/leds/builtin/led1_g"
SUBSYSTEM=="leds", KERNEL=="unoq:user-blue1",  ACTION=="add", RUN+="/bin/ln -sf /sys$devpath /dev/leds/builtin/led1_b"

# --- Sys LEDs (Mapped to led2) ---
SUBSYSTEM=="leds", KERNEL=="unoq:panic-red2",  ACTION=="add", RUN+="/bin/ln -sf /sys$devpath /dev/leds/builtin/led2_r"
SUBSYSTEM=="leds", KERNEL=="unoq:wlan-green2", ACTION=="add", RUN+="/bin/ln -sf /sys$devpath /dev/leds/builtin/led2_g"
SUBSYSTEM=="leds", KERNEL=="unoq:bt-blue2",    ACTION=="add", RUN+="/bin/ln -sf /sys$devpath /dev/leds/builtin/led2_b"

# media-carrier leds
SUBSYSTEM=="leds", KERNEL=="media-carrier:*", ACTION=="add", RUN+="/usr/bin/mkdir -p /dev/leds/media-carrier"
SUBSYSTEM=="leds", KERNEL=="media-carrier:*", ACTION=="remove", RUN+="/usr/bin/mkdir -p /dev/leds/media-carrier"

# --- Media-carrier Led1 ---
SUBSYSTEM=="leds", KERNEL=="media-carrier:red1",   ACTION=="add", RUN+="/bin/ln -sf /sys$devpath /dev/leds/media-carrier/led1_r"
SUBSYSTEM=="leds", KERNEL=="media-carrier:green1", ACTION=="add", RUN+="/bin/ln -sf /sys$devpath /dev/leds/media-carrier/led1_g"
SUBSYSTEM=="leds", KERNEL=="media-carrier:blue1",  ACTION=="add", RUN+="/bin/ln -sf /sys$devpath /dev/leds/media-carrier/led1_b"

# --- Media-carrier Led2 ---
SUBSYSTEM=="leds", KERNEL=="media-carrier:red2",   ACTION=="add", RUN+="/bin/ln -sf /sys$devpath /dev/leds/media-carrier/led2_r"
SUBSYSTEM=="leds", KERNEL=="media-carrier:green2", ACTION=="add", RUN+="/bin/ln -sf /sys$devpath /dev/leds/media-carrier/led2_g"
SUBSYSTEM=="leds", KERNEL=="media-carrier:blue2",  ACTION=="add", RUN+="/bin/ln -sf /sys$devpath /dev/leds/media-carrier/led2_b"

# --- Media-carrier Led3 ---
SUBSYSTEM=="leds", KERNEL=="media-carrier:red3",   ACTION=="add", RUN+="/bin/ln -sf /sys$devpath /dev/leds/media-carrier/led3_r"
SUBSYSTEM=="leds", KERNEL=="media-carrier:green3", ACTION=="add", RUN+="/bin/ln -sf /sys$devpath /dev/leds/media-carrier/led3_g"
SUBSYSTEM=="leds", KERNEL=="media-carrier:blue3",  ACTION=="add", RUN+="/bin/ln -sf /sys$devpath /dev/leds/media-carrier/led3_b"

# --- Media-carrier Led4 ---
SUBSYSTEM=="leds", KERNEL=="media-carrier:red4",   ACTION=="add", RUN+="/bin/ln -sf /sys$devpath /dev/leds/media-carrier/led4_r"
SUBSYSTEM=="leds", KERNEL=="media-carrier:green4", ACTION=="add", RUN+="/bin/ln -sf /sys$devpath /dev/leds/media-carrier/led4_g"
SUBSYSTEM=="leds", KERNEL=="media-carrier:blue4",  ACTION=="add", RUN+="/bin/ln -sf /sys$devpath /dev/leds/media-carrier/led4_b"
